#!/usr/bin/env python3
"""Pixel-compare two PDFs (or two image files) page by page.

  sla-compare A.pdf B.pdf [--dpi 150] [--tol 16] [--out DIR] [--max-diff 0.01] [--pages 1-3]

Both PDFs are rasterised with the same renderer (pdftoppm) at the same DPI, so DPI
differences between the sources do not matter. A pixel counts as different when any
channel differs by more than --tol (0-255). Prints per-page % of differing pixels and
writes diff images (differences in red over a faded page) to --out.
Exit 0 when every page is <= --max-diff percent, else 1.
"""
import argparse, os, subprocess, sys, tempfile, glob
import numpy as np
from PIL import Image

def raster(path, dpi, tmp, tag):
    if path.lower().endswith(".pdf"):
        base = os.path.join(tmp, tag)
        r = subprocess.run(["pdftoppm", "-r", str(dpi), "-png", path, base], stderr=subprocess.DEVNULL)
        if r.returncode: sys.exit(f"sla-compare: cannot render {path} (missing or damaged PDF)")
        return sorted(glob.glob(base + "*.png"), key=lambda p: int(p.rsplit("-", 1)[1][:-4]))
    return [path]

def pages_arg(s, n):
    if not s: return list(range(n))
    out = []
    for part in s.split(","):
        a, _, b = part.partition("-")
        out += range(int(a) - 1, int(b or a))
    return [i for i in out if 0 <= i < n]

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("a"); ap.add_argument("b")
    ap.add_argument("--dpi", type=int, default=150)
    ap.add_argument("--tol", type=int, default=16)
    ap.add_argument("--out"); ap.add_argument("--pages")
    ap.add_argument("--max-diff", type=float, default=0.01)
    a = ap.parse_args()
    with tempfile.TemporaryDirectory() as tmp:
        pa, pb = raster(a.a, a.dpi, tmp, "a"), raster(a.b, a.dpi, tmp, "b")
        if len(pa) != len(pb):
            print(f"PAGE COUNT DIFFERS: {len(pa)} vs {len(pb)}")
        n = min(len(pa), len(pb)); worst = 0.0
        if a.out: os.makedirs(a.out, exist_ok=True)
        for i in pages_arg(a.pages, n):
            A = Image.open(pa[i]).convert("RGB"); B = Image.open(pb[i]).convert("RGB")
            note = ""
            if A.size != B.size:
                note = f" (size {A.size} vs {B.size}, B resized)"
                B = B.resize(A.size, Image.LANCZOS)
            x, y = np.asarray(A, dtype=np.int16), np.asarray(B, dtype=np.int16)
            d = np.abs(x - y).max(axis=2); mask = d > a.tol
            pct = 100.0 * mask.mean(); worst = max(worst, pct)
            box = ""
            if mask.any():
                ys, xs = np.where(mask)
                s = 72.0 / a.dpi
                box = f" bbox_pt=({xs.min()*s:.0f},{ys.min()*s:.0f})-({xs.max()*s:.0f},{ys.max()*s:.0f})"
            print(f"page {i+1}: {pct:.4f}% differ, max channel diff {int(d.max())}{box}{note}")
            if a.out and mask.any():
                faded = (np.asarray(A, dtype=np.float32) * 0.35 + 255 * 0.65).astype(np.uint8)
                faded[mask] = (230, 0, 0)
                Image.fromarray(faded).save(os.path.join(a.out, f"diff-p{i+1:03d}.png"))
        ok = worst <= a.max_diff and len(pa) == len(pb)
        print(f"{'MATCH' if ok else 'MISMATCH'}: worst page {worst:.4f}% (limit {a.max_diff}%)")
        sys.exit(0 if ok else 1)
main()
